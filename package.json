{
  "name": "@n1k1t/pipelain",
  "version": "0.4.14",
  "description": "Powerful utility to build and execute type-safe AI pipelines with structured outputs and tool integration",
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "scripts": {
    "test": "NODE_ENV=test jest --silent",
    "test:coverage": "NODE_ENV=test jest --coverage",
    "run:pipelain:main": "npx ts-node test/index.ts",
    "run:pipelain:tool": "npx ts-node test/tool.ts",
    "run:pipelain:skill": "npx ts-node test/skill.ts",
    "run:pipelain:report": "npx ts-node test/report.ts",
    "run:pipelain:fallback": "npx ts-node test/fallback.ts",
    "build": "rm -rf lib && npx tsc",
    "build:check": "npx tsc --noEmit",
    "prepare": "husky",
    "preversion": "npm run build:check && npm test",
    "version": "git add -A .",
    "postversion": "npm run build && git push && git push --tags"
  },
  "jest": {
    "preset": "ts-jest",
    "passWithNoTests": true,
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/*.spec.ts"
    ],
    "coverageReporters": [
      "cobertura",
      "text"
    ],
    "collectCoverageFrom": [
      "<rootDir>/src/**/*.ts"
    ],
    "setupFilesAfterEnv": [
      "jest-extended/all"
    ],
    "setupFiles": [],
    "transformIgnorePatterns": [],
    "transform": {
      ".+\\.[tj]sx?$": [
        "ts-jest",
        {
          "isolatedModules": true,
          "tsconfig": {
            "allowJs": true
          }
        }
      ]
    }
  },
  "engines": {
    "node": ">=20.16.0"
  },
  "keywords": [
    "ai",
    "pipeline",
    "llm",
    "type-safe",
    "zod",
    "structured-outputs",
    "mcp",
    "agents",
    "automation",
    "typescript"
  ],
  "homepage": "https://github.com/n1k1t/pipelain",
  "author": "n1k1t",
  "license": "MIT",
  "devDependencies": {
    "@langfuse/otel": "4.6.1",
    "@n1k1t/unit-generator": "1.1.3",
    "@opentelemetry/sdk-node": "0.213.0",
    "@types/cheerio": "0.22.35",
    "@types/commander": "2.12.2",
    "@types/jest": "29.5.11",
    "@types/jsdom": "28.0.1",
    "@types/json2md": "1.5.4",
    "@types/lodash": "4.14.184",
    "@types/minimatch": "5.1.2",
    "@types/node": "22.13.14",
    "@types/proper-lockfile": "4.1.4",
    "@types/turndown": "5.0.6",
    "@types/uuid": "8.3.4",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-extended": "4.0.2",
    "ts-jest": "29.1.1",
    "ts-node": "10.9.2",
    "typescript": "5.7.2"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.49",
    "@ai-sdk/google": "4.0.63",
    "@ai-sdk/mcp": "2.0.44",
    "@ai-sdk/mistral": "4.0.39",
    "@ai-sdk/openai": "4.0.58",
    "@ai-sdk/openai-compatible": "3.0.43",
    "@ast-grep/napi": "0.42.0",
    "ai": "7.0.92",
    "colors": "1.4.0",
    "commander": "9.4.0",
    "dayjs": "1.11.21",
    "dotenv": "16.4.7",
    "fast-glob": "3.3.3",
    "fast-xml-parser": "4.5.0",
    "gray-matter": "4.0.3",
    "handlebars": "4.7.9",
    "json2md": "2.0.3",
    "lodash": "4.17.21",
    "minimatch": "5.1.0",
    "proper-lockfile": "4.1.2",
    "reflect-metadata": "0.2.1",
    "string-argv": "0.3.2",
    "turndown": "7.2.2",
    "uuid": "9.0.0",
    "yaml": "2.8.0",
    "zocker": "3.0.0",
    "zod": "4.3.6"
  }
}
